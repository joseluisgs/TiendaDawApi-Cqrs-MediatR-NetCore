meta {
  name: [069] MUTATION - Crear cat no existe
  type: graphql
  seq: 6
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:graphql {
  mutation($input: CreateProductoInput!) { createProducto(input: $input) { id nombre } }
}

body:graphql:vars {
  {"input": {"nombre": "Test", "precio": 99, "stock": 10, "categoriaId": 999999}}
}

script:post-response {
  test("GraphQL CreateProducto NotFound - Returns null data", function () {
      const jsonData = res.getBody();
      // La API responde con errors + data:null (o data sin el campo) cuando la
      // categoría no existe: aceptamos ambos formatos de fallo GraphQL.
      const resultado = jsonData?.data ? jsonData.data.createProducto ?? null : null;
      expect(resultado).to.be.null;
  });
}

settings {
  encodeUrl: true
}

docs {
  GraphQL: Crear producto con categoría inexistente debe fallar
}
